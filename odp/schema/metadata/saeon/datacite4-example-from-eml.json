  "descriptions": [
    {
      "description": "Data were collected using onboard fisheries observers who monitored longline fishing operations targeting Patagonian toothfish around the Prince Edward and Marion Islands between 2009 and 2023. Observers recorded benthic bycatch by identifying, counting and weighing taxa from selected longline segments. Data were captured using standardized field sheets and later digitised into a central database.\n\nQuality Control: All records were validated through double data entry checks, taxonomic verification against WoRMS, and automated range checks for spatial coordinates and species occurrence. Outliers were flagged and reviewed by a senior marine ecologist prior to publication.",
      "descriptionType": "Methods"
    },
    {
      "description": "To assess the impact of rising sea temperatures on coastal biodiversity over a 10-year period.",
      "descriptionType": "Other"
    },
    {
      "description": "This dataset contains long-term monitoring data regarding macroalgae and invertebrate populations collected along the rocky shores of False Bay, South Africa.",
      "descriptionType": "Abstract"
    },
    {
      "description": "-21, 5, meter",
      "descriptionType": "TechnicalInfo"
    }
